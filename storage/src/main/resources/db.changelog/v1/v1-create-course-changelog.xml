<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <property name="db.username" value="${POSTGRES_USERNAME}"/>

    <changeSet id="v1-3" author="db.username">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="courses"/>
            </not>
        </preConditions>
        <createTable tableName="courses">
            <column name="start_date" type="TIMESTAMP(6)">
                <constraints nullable="false" />
            </column>
            <column name="end_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_courses"/>
            </column>
            <column name="course_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(225)" defaultValue="https://neostudy.neoflex.ru">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints checkConstraint="CHECK (status IN ('OPENED', 'NOT_STARTED', 'CLOSED'))" nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="courses" columnNames="course_name, start_date"
                             constraintName="unique_application_on_course_for_user"/>
    </changeSet>
</databaseChangeLog>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <property name="db.username" value="${POSTGRES_USERNAME}"/>


    <changeSet id="v1-2" author="db.username">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="applications"/>
            </not>
        </preConditions>
        <createTable tableName="applications">
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_credit"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints
                        checkConstraint="CHECK (status IN ('PRE_APPLICATION', 'PROCESSING', 'REFUSED', 'ACCEPTED'))"
                        nullable="false"/>
            </column>

            <column name="user_id" type="UUID">
                <constraints foreignKeyName="fk_registred_users" references="registered_users(id)" nullable="false"/>
            </column>

            <column name="course_id" type="UUID">
                <constraints foreignKeyName="fk_courses" references="courses(id)" nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>